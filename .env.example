# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# MySQL (run schema.sql first)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=driversense
# Set to true for Azure Database for MySQL (it requires SSL)
DB_SSL=false

# Same Firebase project the app uses (EXPO_PUBLIC_FIREBASE_PROJECT_ID in the app's .env)
FIREBASE_PROJECT_ID=

# Local testing with Postman only: lets you send "X-Debug-Uid: test-user"
# instead of a Firebase token. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false
